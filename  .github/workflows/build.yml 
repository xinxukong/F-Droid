name: 构建F-Droid仓库

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  pages: write
  id-token: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: 下载代码
        uses: actions/checkout@v4

      - name: 安装fdroidserver
        run: |
          sudo apt-get update
          sudo apt-get install -y fdroidserver

      - name: 生成签名密钥
        run: |
          if [ ! -f keystore.p12 ]; then
            keytool -genkeypair -keystore keystore.p12 -storetype PKCS12 -storepass 12345678 -alias fdroid -keypass 12345678 -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=github.io, O=Personal, C=CN"
          fi

      - name: 更新仓库索引
        run: |
          fdroid update --create-metadata

      - name: 保存密钥
        run: |
          git config user.name "bot"
          git config user.email "bot@bot.com"
          git add keystore.p12 || true
          git commit -m "save keystore" || true
          git push || true

      - name: 开启Pages
        uses: actions/configure-pages@v4

      - name: 上传仓库内容
        uses: actions/upload-pages-artifact@v3
        with:
          path: 'repo'

      - name: 部署
        uses: actions/deploy-pages@v4
